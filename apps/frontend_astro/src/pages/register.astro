---
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import MainLayout from "@/presentation/layouts/MainLayout.astro";
---

<MainLayout title="Registrarse">
  <div class="flex items-center justify-center min-h-screen bg-background">
    <Card class="w-full max-w-md">
      <CardHeader class="space-y-1">
        <CardTitle class="text-2xl">Crear Cuenta</CardTitle>
        <CardDescription>
          Únete a Laboratorio 3026
        </CardDescription>
      </CardHeader>
      <CardContent>
        <form
          id="register-form"
          action="/api/auth/register"
          method="POST"
          autocomplete="off"
        >
          <div class="space-y-4">
            <div class="space-y-2">
              <Label htmlFor="username">Usuario</Label>
              <Input
                id="username"
                name="username"
                type="text"
                placeholder="Tu usuario"
                autocomplete="off"
                required
              />
            </div>

            <div class="space-y-2">
              <Label htmlFor="email">Email</Label>
              <Input
                id="email"
                name="email"
                type="email"
                placeholder="tu@email.com"
                autocomplete="off"
                required
              />
            </div>

            <div class="space-y-2">
              <Label htmlFor="password">Contraseña</Label>
              <Input
                id="password"
                name="password"
                type="password"
                placeholder="••••••••"
                autocomplete="off"
                required
              />
            </div>

            <div class="space-y-2">
              <Label htmlFor="confirmPassword">Confirmar Contraseña</Label>
              <Input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                placeholder="••••••••"
                autocomplete="off"
                required
              />
            </div>

            <div class="flex items-start gap-2">
              <input
                type="checkbox"
                id="terms"
                name="terms"
                required
                class="mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
              />
              <Label htmlFor="terms" class="text-sm text-muted-foreground">
                Acepto los
                <a href="/terms" class="text-primary hover:underline">Términos</a>
                y la
                <a href="/privacy" class="text-primary hover:underline">Política de Privacidad</a>
              </Label>
            </div>

            <Button type="submit" class="w-full">
              Crear Cuenta
            </Button>

            <div class="htmx-indicator flex items-center justify-center gap-2 text-muted-foreground">
              <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span>Creando cuenta...</span>
            </div>
          </div>
        </form>

        <div class="mt-4 text-center text-sm">
          <span class="text-muted-foreground">¿Ya tienes cuenta? </span>
          <a href="/login-nocache" class="text-primary hover:underline font-medium">
            Inicia Sesión
          </a>
        </div>
      </CardContent>
    </Card>
  </div>

  <script>
    (function() {
      if (window.location.search) {
        window.history.replaceState(null, '', '/register');
      }
      var form = document.getElementById('register-form');
      if (form) form.reset();
    })();

    window.addEventListener('pageshow', function() {
      if (window.location.search) {
        window.history.replaceState(null, '', '/register');
      }
      var form = document.getElementById('register-form');
      if (form) form.reset();
    });

    document.addEventListener('htmx:responseError', (e: any) => {
      const xhr = e.detail.xhr;
      if (xhr.status === 429) {
        const form = document.getElementById('register-form');
        if (form) {
          const errorDiv = document.createElement('div');
          errorDiv.className = 'bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4';
          errorDiv.textContent = 'Demasiados intentos. Por favor espera un momento e intenta de nuevo.';
          form.insertBefore(errorDiv, form.firstChild);
        }
        e.preventDefault();
      }
    });
  </script>
</MainLayout>
