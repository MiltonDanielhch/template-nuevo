---
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import MainLayout from "@/presentation/layouts/MainLayout.astro";
---

<MainLayout title="Registrarse">
  <div class="flex items-center justify-center min-h-screen bg-background">
    <Card class="w-full max-w-md">
      <CardHeader class="space-y-1">
        <CardTitle class="text-2xl">Crear Cuenta</CardTitle>
        <CardDescription>
          Únete a Laboratorio 3026
        </CardDescription>
      </CardHeader>
      <CardContent>
        <form
          id="register-form"
          hx-post="/api/auth/register"
          hx-target="#register-form"
          hx-swap="outerHTML"
          hx-indicator=".htmx-indicator"
        >
          <div class="space-y-4">
            <div class="space-y-2">
              <Label for="email">Email</Label>
              <Input
                id="email"
                name="email"
                type="email"
                placeholder="tu@email.com"
                required
              />
            </div>

            <div class="space-y-2">
              <Label for="password">Contraseña</Label>
              <Input
                id="password"
                name="password"
                type="password"
                placeholder="••••••••"
                required
              />
            </div>

            <div class="space-y-2">
              <Label for="confirmPassword">Confirmar Contraseña</Label>
              <Input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                placeholder="••••••••"
                required
              />
            </div>

            <div class="flex items-start gap-2">
              <input
                type="checkbox"
                id="terms"
                name="terms"
                required
                class="mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
              />
              <Label for="terms" class="text-sm text-muted-foreground">
                Acepto los
                <a href="/terms" class="text-primary hover:underline">Términos</a>
                y la
                <a href="/privacy" class="text-primary hover:underline">Política de Privacidad</a>
              </Label>
            </div>

            <Button type="submit" class="w-full">
              Crear Cuenta
            </Button>

            <div class="htmx-indicator flex items-center justify-center gap-2 text-muted-foreground">
              <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span>Creando cuenta...</span>
            </div>
          </div>
        </form>

        <div class="mt-4 text-center text-sm">
          <span class="text-muted-foreground">¿Ya tienes cuenta? </span>
          <a href="/login" class="text-primary hover:underline font-medium">
            Inicia Sesión
          </a>
        </div>
      </CardContent>
    </Card>
  </div>

  <script>
    document.addEventListener('htmx:afterRequest', (e) => {
      if (e.detail.successful) {
        const response = e.detail.xhr;
        if (response.status === 200 || response.status === 201) {
          window.location.href = '/dashboard';
        }
      }
    });
  </script>
</MainLayout>
