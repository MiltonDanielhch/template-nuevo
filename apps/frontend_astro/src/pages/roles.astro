---
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import Navbar from "@/presentation/components/shared/Navbar.astro";
import Sidebar from "@/presentation/components/shared/Sidebar.astro";
import MainLayout from "@/presentation/layouts/MainLayout.astro";

export const prerender = false;

const token = Astro.cookies.get("auth_token")?.value;
let allRoles = [];
let availablePermissions = [];

try {
  const [rolesRes, permsRes] = await Promise.all([
    fetch("http://localhost:8081/roles", {
      headers: { Authorization: `Bearer ${token}` },
    }),
    fetch("http://localhost:8081/permissions", {
      headers: { Authorization: `Bearer ${token}` },
    }),
  ]);

  if (rolesRes.ok) {
    allRoles = await rolesRes.json();
  }

  if (permsRes.ok) {
    availablePermissions = await permsRes.json();
  }
} catch (error) {
  console.error("Error fetching RBAC data on SSR:", error);
}
---

<MainLayout title="Gestión de Roles">
  <div
    class="flex h-screen flex-col"
    x-data="rolesManagement"
  >
    <Navbar />
    <div class="flex flex-1 overflow-hidden">
      <Sidebar />
      <main class="flex-1 overflow-y-auto bg-background p-6">
        <div class="mx-auto max-w-6xl">
          <div class="mb-8 flex items-center justify-between">
            <div>
              <h1 class="text-3xl font-bold tracking-tight text-foreground">Roles y Permisos</h1>
              <p class="text-muted-foreground">Define las capacidades de cada nivel de usuario</p>
            </div>
            <button
              class="inline-flex h-8 shrink-0 items-center justify-center gap-2 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring cursor-pointer"
              @click="resetForm(); openModal = true"
            >
              Nuevo Rol
            </button>
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {allRoles.map((role) => (
              <Card class="flex flex-col border-border bg-card">
                <CardHeader>
                  <div class="flex items-center justify-between">
                    <CardTitle>{role.name}</CardTitle>
                    <span class="text-xs text-muted-foreground">{role.permissions.length} permisos</span>
                  </div>
                  <p class="text-sm text-muted-foreground">{role.description || 'Sin descripción'}</p>
                </CardHeader>
                <CardContent class="flex-1">
                  <div class="flex flex-wrap gap-1 mb-4">
                    {role.permissions.length > 0 ? (
                        role.permissions.map((perm) => (
                        <span class="inline-flex items-center rounded-md bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground border border-border" title={perm.id}>
                            {perm.name}
                        </span>
                        ))
                    ) : (
                        <span class="text-[10px] text-muted-foreground italic">Sin permisos asignados</span>
                    )}
                  </div>
                  <div class="flex justify-end gap-2 mt-auto pt-4 border-t border-border">
                    <button
                       @click={`editRole($el.dataset.role)`}
                       data-role={JSON.stringify(role)}
                       class="text-sm font-medium text-primary hover:underline cursor-pointer"
                    >
                      Editar
                    </button>
                    {!['Admin', 'User'].includes(role.name) && (
                      <button
                        hx-delete={`/api/roles/${role.id}`}
                        hx-confirm={`¿Eliminar el rol ${role.name}?`}
                        hx-on="htmx:afterRequest: window.location.reload()"
                        class="text-sm font-medium text-destructive hover:underline cursor-pointer"
                      >
                        Eliminar
                      </button>
                    )}
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        </div>
      </main>
    </div>

    <!-- Modal de Rol -->
    <div
      x-show="openModal"
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
      @click.self="openModal = false"
      style="display: none;"
    >
      <div class="w-full max-w-lg rounded-xl border border-border bg-card p-6 shadow-2xl">
        <h2 class="text-xl font-bold mb-4" x-text="isEdit ? 'Editar Rol' : 'Crear Nuevo Rol'"></h2>

        <form @submit.prevent="submitForm()" class="space-y-4">
          <div class="space-y-2">
            <label class="text-sm font-medium text-foreground">Nombre</label>
            <Input x-model="form.name" placeholder="Ej: Editor" required :disabled="['Admin', 'User'].includes(form.name) && isEdit" />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium text-foreground">Descripción</label>
            <Input x-model="form.description" placeholder="Opcional..." />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium text-foreground">Permisos</label>
            <div class="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto p-2 border border-border rounded-lg bg-muted/50">
              <template x-for="perm in availablePermissions" :key="perm.id">
                <label class="flex items-center gap-2 p-1 hover:bg-muted rounded cursor-pointer transition-colors">
                  <input type="checkbox" :value="perm.id" x-model="form.permissions" class="rounded border-border text-primary focus:ring-primary h-4 w-4" />
                  <span class="text-xs text-foreground" x-text="perm.name"></span>
                </label>
              </template>
              {availablePermissions.length === 0 && (
                  <span class="col-span-2 text-xs text-muted-foreground italic text-center py-2">No hay permisos disponibles en el sistema o no tienes acceso.</span>
              )}
            </div>
          </div>

          <div class="flex justify-end gap-3 pt-4 border-t border-border">
            <Button type="button" variant="outline" @click="openModal = false">Cancelar</Button>
            <Button type="submit" x-text="isEdit ? 'Actualizar' : 'Crear'"></Button>
          </div>
        </form>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ initialAvailablePermissions: availablePermissions }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('rolesManagement', () => ({
      openModal: false,
      isEdit: false,
      editId: '',
      form: { name: '', description: '', permissions: [] },
      availablePermissions: initialAvailablePermissions || [],

      init() {
        console.log('Roles Management initialized with permissions:', this.availablePermissions);
      },

      editRole(roleData) {
        const role = typeof roleData === 'string' ? JSON.parse(roleData) : roleData;
        console.log('Editing role:', role);
        this.isEdit = true;
        this.editId = role.id;
        this.form = {
          name: role.name,
          description: role.description || '',
          // Extract just IDs for the checkboxes
          permissions: role.permissions.map(p => p.id)
        };
        this.openModal = true;
      },

      resetForm() {
        this.isEdit = false;
        this.editId = '';
        this.form = { name: '', description: '', permissions: [] };
      },

      async submitForm() {
        const url = this.isEdit ? `/api/roles/${this.editId}` : '/api/roles';

        try {
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.form)
          });

          if (response.ok) {
            window.location.reload();
          } else {
            const data = await response.json();
            alert(data.message || 'Error al procesar la solicitud');
          }
        } catch (e) {
          alert('Error de conexión');
        }
      }
    }));
  });
</script>
