---
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import Navbar from "@/presentation/components/shared/Navbar.astro";
import Sidebar from "@/presentation/components/shared/Sidebar.astro";
import MainLayout from "@/presentation/layouts/MainLayout.astro";

export const prerender = false;

const token = Astro.cookies.get("auth_token")?.value;
let allRoles = [];
let availablePermissions = [];

try {
  const [rolesRes, permsRes] = await Promise.all([
    fetch("http://localhost:8081/roles", {
      headers: { Authorization: `Bearer ${token}` },
    }),
    fetch("http://localhost:8081/permissions", {
      headers: { Authorization: `Bearer ${token}` },
    }),
  ]);

  if (rolesRes.ok) {
    allRoles = await rolesRes.json();
  }

  if (permsRes.ok) {
    availablePermissions = await permsRes.json();
  } else {
    console.error("Error fetching permissions:", permsRes.status, await permsRes.text());
  }
} catch (error) {
  console.error("Error fetching RBAC data on SSR:", error);
}
---

<MainLayout title="Gestión de Roles">
  <div class="flex h-screen flex-col">
    <Navbar />
    <div class="flex flex-1 overflow-hidden">
      <Sidebar />
      <main class="flex-1 overflow-y-auto bg-background p-6">
        <div class="mx-auto max-w-6xl">
          <div class="mb-8 flex items-center justify-between">
            <div>
              <h1 class="text-3xl font-bold tracking-tight text-foreground">Roles y Permisos</h1>
              <p class="text-muted-foreground">Define las capacidades de cada nivel de usuario</p>
            </div>
            <button
              class="inline-flex h-8 shrink-0 items-center justify-center gap-2 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring cursor-pointer"
              onclick="openRoleModal()"
            >
              Nuevo Rol
            </button>
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {allRoles.map((role) => (
              <Card class="flex flex-col border-border bg-card">
                <CardHeader>
                  <div class="flex items-center justify-between">
                    <CardTitle>{role.name}</CardTitle>
                    <span class="text-xs text-muted-foreground">{role.permissions.length} permisos</span>
                  </div>
                  <p class="text-sm text-muted-foreground">{role.description || 'Sin descripción'}</p>
                </CardHeader>
                <CardContent class="flex-1">
                  <div class="flex flex-wrap gap-1 mb-4">
                    {role.permissions.length > 0 ? (
                        role.permissions.map((perm) => (
                        <span class="inline-flex items-center rounded-md bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground border border-border" title={perm.id}>
                            {perm.name}
                        </span>
                        ))
                    ) : (
                        <span class="text-[10px] text-muted-foreground italic">Sin permisos asignados</span>
                    )}
                  </div>
                  <div class="flex justify-end gap-2 mt-auto pt-4 border-t border-border">
                    <button
                       onclick={`editRole('${encodeURIComponent(JSON.stringify(role))}')`}
                       class="text-sm font-medium text-primary hover:underline cursor-pointer"
                    >
                      Editar
                    </button>
                    {!['Admin', 'User'].includes(role.name) && (
                      <button
                        onclick={`deleteRole('${role.id}', '${role.name}')`}
                        class="text-sm font-medium text-destructive hover:underline cursor-pointer"
                      >
                        Eliminar
                      </button>
                    )}
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        </div>
      </main>
    </div>

    <!-- Modal de Rol -->
    <div
      id="role-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
      onclick="closeRoleModal(event)"
    >
      <div
        onclick="event.stopPropagation()"
        class="w-full max-w-lg rounded-xl border border-border bg-card p-6 shadow-2xl"
      >
        <h2 id="role-modal-title" class="text-xl font-bold mb-4">Crear Nuevo Rol</h2>

        <form id="role-form" onsubmit="submitRoleForm(event)" class="space-y-4">
          <input type="hidden" id="role-edit-id" value="" />
          <div class="space-y-2">
            <label class="text-sm font-medium text-foreground">Nombre</label>
            <Input id="role-name" placeholder="Ej: Editor" required />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium text-foreground">Descripción</label>
            <Input id="role-description" placeholder="Opcional..." />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium text-foreground">Permisos</label>
            <div id="role-permissions" class="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto p-2 border border-border rounded-lg bg-muted/50">
              {availablePermissions.length === 0 && (
                  <span class="col-span-2 text-xs text-muted-foreground italic text-center py-2">No hay permisos disponibles en el sistema o no tienes acceso.</span>
              )}
            </div>
          </div>

          <div class="flex justify-end gap-3 pt-4 border-t border-border">
            <button type="button" class="px-4 py-2 border border-input bg-background rounded-md hover:bg-muted text-sm font-medium" onclick="closeRoleModal()">Cancelar</button>
            <Button type="submit" id="role-submit-btn">Crear</Button>
          </div>
        </form>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ availablePermissions }}>
  const permissions = availablePermissions || [];

  function initPermissions() {
    const container = document.getElementById('role-permissions');
    if (!container || permissions.length === 0) return;

    container.innerHTML = permissions.map(p =>
      '<label class="flex items-center gap-2 p-1 hover:bg-muted rounded cursor-pointer transition-colors">' +
        '<input type="checkbox" name="permissions" value="' + p.id + '" class="rounded border-border text-primary focus:ring-primary h-4 w-4" />' +
        '<span class="text-xs text-foreground">' + p.name + '</span>' +
      '</label>'
    ).join('');
  }

  window.openRoleModal = function() {
    document.getElementById('role-edit-id').value = '';
    document.getElementById('role-name').value = '';
    document.getElementById('role-description').value = '';
    document.getElementById('role-modal-title').textContent = 'Crear Nuevo Rol';
    document.getElementById('role-submit-btn').textContent = 'Crear';
    document.getElementById('role-name').disabled = false;

    const checkboxes = document.querySelectorAll('#role-permissions input[type="checkbox"]');
    checkboxes.forEach(cb => cb.checked = false);

    document.getElementById('role-modal').classList.remove('hidden');
    document.getElementById('role-modal').classList.add('flex');
  };

  window.editRole = function(roleData) {
    try {
      const role = JSON.parse(decodeURIComponent(roleData));
      document.getElementById('role-edit-id').value = role.id;
      document.getElementById('role-name').value = role.name;
      document.getElementById('role-description').value = role.description || '';
      document.getElementById('role-modal-title').textContent = 'Editar Rol';
      document.getElementById('role-submit-btn').textContent = 'Actualizar';
      document.getElementById('role-name').disabled = ['Admin', 'User'].includes(role.name);

      const checkboxes = document.querySelectorAll('#role-permissions input[type="checkbox"]');
      checkboxes.forEach(cb => {
        cb.checked = role.permissions.some(p => p.id === cb.value || p === cb.value);
      });

      document.getElementById('role-modal').classList.remove('hidden');
      document.getElementById('role-modal').classList.add('flex');
    } catch(e) {
      console.error('Error parsing role:', e);
    }
  };

  window.closeRoleModal = function(event) {
    if (event && event.target !== event.currentTarget) return;
    document.getElementById('role-modal').classList.add('hidden');
    document.getElementById('role-modal').classList.remove('flex');
  };

  window.submitRoleForm = async function(e) {
    e.preventDefault();

    const editId = document.getElementById('role-edit-id').value;
    const url = editId ? '/api/roles/' + editId : '/api/roles';

    const name = document.getElementById('role-name').value;
    const description = document.getElementById('role-description').value;
    const permissions = Array.from(document.querySelectorAll('#role-permissions input[type="checkbox"]:checked')).map(cb => cb.value);

    const token = document.querySelector('meta[name="auth-token"]')?.getAttribute('content') || '';

    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },
        body: JSON.stringify({ name, description, permissions })
      });

      if (response.ok) {
        window.location.reload();
      } else if (response.status === 401 || response.status === 403) {
        window.location.href = '/login';
      } else {
        const data = await response.json();
        alert(data.message || 'Error al procesar');
      }
    } catch (err) {
      alert('Error de conexión');
    }
  };

  window.deleteRole = async function(roleId, roleName) {
    if (!confirm('¿Eliminar el rol ' + roleName + '?')) return;

    const token = document.querySelector('meta[name="auth-token"]')?.getAttribute('content') || '';

    try {
      const response = await fetch('/api/roles/' + roleId, {
        method: 'DELETE',
        headers: {
          'Authorization': 'Bearer ' + token
        }
      });

      if (response.ok) {
        window.location.reload();
      } else if (response.status === 401 || response.status === 403) {
        window.location.href = '/login';
      } else {
        const data = await response.json();
        alert(data.message || 'Error al eliminar');
      }
    } catch (err) {
      alert('Error de conexión');
    }
  };

  document.addEventListener('DOMContentLoaded', initPermissions);
  document.addEventListener('astro:page-load', initPermissions);
</script>
