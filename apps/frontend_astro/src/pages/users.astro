---
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import Navbar from "@/presentation/components/shared/Navbar.astro";
import Sidebar from "@/presentation/components/shared/Sidebar.astro";
import MainLayout from "@/presentation/layouts/MainLayout.astro";

export const prerender = false;

const token = Astro.cookies.get("auth_token")?.value;
const page = parseInt(Astro.url.searchParams.get("page") || "1", 10);
const search = Astro.url.searchParams.get("search") || "";

// Fetch users server-side
let usersData: any = { users: [], total: 0, page: 1, total_pages: 1 };
let fetchError = "";

if (token) {
  try {
    const params = new URLSearchParams({ page: page.toString(), per_page: "10" });
    if (search) params.set("search", search);

    const response = await fetch(`http://localhost:8081/api/v1/users?${params}`, {
      headers: { Authorization: `Bearer ${token}` },
    });

    if (response.ok) {
      usersData = await response.json();
    } else {
      fetchError = "Error al cargar usuarios";
    }
  } catch (_e) {
    fetchError = "Error de conexión";
  }
} else {
  fetchError = "Sin sesión";
}

const users = usersData.users || [];
---

<MainLayout title="Gestión de Usuarios">
  <div class="flex h-screen flex-col">
    <Navbar />
    <div class="flex flex-1 overflow-hidden">
      <Sidebar />
      <main class="flex-1 overflow-y-auto bg-background p-6">
        <div class="mx-auto max-w-6xl">
          <div class="mb-8 flex items-center justify-between">
            <div>
              <h1 class="text-3xl font-bold text-foreground">Usuarios</h1>
              <p class="text-muted-foreground">Gestiona los usuarios del sistema</p>
            </div>
            <button type="button" onclick="showModal(false)" class="inline-flex h-9 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90">
              + Nuevo Usuario
            </button>
          </div>

          <!-- Search -->
          <div class="mb-4 flex items-center gap-2">
            <input type="hidden" id="page-input" value={page} />
            <div class="flex items-center gap-2">
              <input
                type="text"
                id="users-search-input"
                placeholder="Buscar por nombre o email..."
                oninput="window.handleSearch(this.value)"
                name="search"
                class="h-9 w-full max-w-sm rounded-lg border border-input bg-transparent px-3 py-1 text-sm transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50"
              />
              <button type="button" onclick="const input=document.getElementById('users-search-input'); const val=input.value; window.doSearch(val);" class="h-9 px-4 py-2 rounded-lg border border-input bg-muted hover:bg-muted/80 text-sm font-medium transition-colors">
                Buscar
              </button>
            </div>
          </div>

          <Card class="p-0 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full min-w-[700px]">
                <thead class="bg-muted/50">
                  <tr>
                    <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase whitespace-nowrap w-16">Avatar</th>
                    <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase whitespace-nowrap">Usuario</th>
                    <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase whitespace-nowrap">Email</th>
                    <th class="px-3 py-3 text-center text-xs font-medium text-muted-foreground uppercase whitespace-nowrap">Rol</th>
                    <th class="px-3 py-3 text-right text-xs font-medium text-muted-foreground uppercase whitespace-nowrap">Acción</th>
                  </tr>
                </thead>
                <tbody id="users-container">
                  {fetchError ? (
                    <tr><td colspan="5" class="px-4 py-8 text-center text-red-500">{fetchError}</td></tr>
                  ) : users.length === 0 ? (
                    <tr><td colspan="5" class="px-4 py-8 text-center text-muted-foreground">No se encontraron usuarios</td></tr>
                  ) : (
                    users.map((user: any) => (
                      <tr class="hover:bg-muted/50">
                        <td class="px-4 py-3">
                          {user.avatar_url ? (
                            <img src={user.avatar_url} class="h-10 w-10 rounded-full object-cover" />
                          ) : (
                            <div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center">
                              <span class="text-sm font-bold text-primary">{(user.username || user.email || "U").charAt(0).toUpperCase()}</span>
                            </div>
                          )}
                        </td>
                        <td class="px-4 py-3 font-medium">{user.username || "Sin nombre"}</td>
                        <td class="px-4 py-3 text-muted-foreground">{user.email}</td>
                        <td class="px-4 py-3">
                          <span class={`px-2 py-1 rounded-full text-xs ${(user.roles || []).includes("Admin") ? "bg-primary/10 text-primary" : "bg-muted"}`}>
                            {user.role || "User"}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right">
                          <button type="button" data-id={user.id} data-user={user.username || ""} data-email={user.email} data-role={user.role || "User"} data-avatar={user.avatar_url || ""} onclick={`openEdit(this)`} class="text-sm text-muted-foreground hover:text-primary mr-3">Editar</button>
                          <button type="button" data-id={user.id} data-name={user.username || user.email} onclick={`deleteUser(this)`} class="text-sm text-red-500 hover:text-red-700">Eliminar</button>
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
            {usersData.total_pages > 1 && (
              <div id="pagination-ssr" class="mt-4 flex items-center justify-end gap-1 w-full">
                <button
                  disabled={page <= 1}
                  onclick={`goToPage(${page - 1})`}
                  class={`px-3 py-1 text-sm border rounded hover:bg-muted ${page <= 1 ? "opacity-50 cursor-not-allowed" : ""}`}>Anterior</button>
                <span class="px-3 py-1 text-sm">Página {page} de {usersData.total_pages}</span>
                <button
                  disabled={page >= usersData.total_pages}
                  onclick={`goToPage(${page + 1})`}
                  class={`px-3 py-1 text-sm border rounded hover:bg-muted ${page >= usersData.total_pages ? "opacity-50 cursor-not-allowed" : ""}`}>Siguiente</button>
              </div>
            )}
          </Card>
        </div>
        </main>
    </div>
  </div>

  <!-- Modal -->
  <div id="modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50" onclick="closeModal(event)">
    <div class="w-full max-w-md rounded-xl border bg-card p-6 shadow-2xl" onclick="event.stopPropagation()">
      <div class="mb-4 flex items-center justify-between">
        <h2 id="modal-title" class="text-lg font-semibold">Nuevo Usuario</h2>
        <button type="button" onclick="hideModal()" class="text-muted-foreground hover:text-foreground">&times;</button>
      </div>

      <form id="user-form" onsubmit="saveUser(event)">
        <input type="hidden" id="user-id" />

        <div class="space-y-4">
          <div>
            <label class="text-sm font-medium">Usuario</label>
            <Input id="username" required placeholder="Nombre de usuario" autocomplete="username" />
          </div>

          <div>
            <label class="text-sm font-medium">Email</label>
            <Input id="email" type="email" required placeholder="correo@ejemplo.com" autocomplete="email" />
          </div>

          <div>
            <label class="text-sm font-medium">Avatar</label>
            <div class="flex items-center gap-4">
              <div id="avatar-preview" class="h-16 w-16 rounded-full bg-muted flex items-center justify-center overflow-hidden">
                <span class="text-xs text-muted-foreground">Sin img</span>
              </div>
              <input type="file" id="avatar-input" accept="image/*" onchange="compressAvatar(this)" class="text-sm" />
            </div>
          </div>

          <div>
            <label class="text-sm font-medium">Contraseña</label>
            <Input id="password" type="password" placeholder="•••••••" autocomplete="current-password" />
            <p id="password-hint" class="text-xs text-muted-foreground mt-1 hidden">(Dejar en blanco para no cambiar)</p>
          </div>

          <div>
            <label class="text-sm font-medium">Rol</label>
            <select id="role-select" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" required>
              <option value="User">Usuario</option>
              <option value="Admin">Administrador</option>
            </select>
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-3">
          <Button type="button" variant="outline" onclick="hideModal()">Cancelar</Button>
          <Button type="submit" id="submit-btn">Guardar</Button>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script is:inline>
window.currentAvatar = '';
window.searchTimeout = null;

window.handleSearch = function(value) {
  clearTimeout(window.searchTimeout);
  window.searchTimeout = setTimeout(function() {
    window.doSearch(value);
  }, 400);
};

window.doSearch = function(searchValue) {
  const value = searchValue !== undefined ? searchValue : document.getElementById('users-search-input').value;
  const isMobile = window.innerWidth < 768;

  const url = '/api/users/list?search=' + encodeURIComponent(value) + '&page=1' + (isMobile ? '&mobile=true' : '');

  fetch(url, {
    headers: { 'HX-Request': 'true' }
  })
  .then(function(res) {
    return res.text();
  })
  .then(function(html) {
    if (isMobile) {
      document.getElementById('users-container-mobile').innerHTML = html;
    } else {
      document.getElementById('users-container').innerHTML = html;
    }
  })
  .catch(function(err) {
    console.error('Error en búsqueda:', err);
  });
};

window.goToPage = function(pageNum) {
  const value = document.getElementById('users-search-input').value;
  const baseUrl = '/users?page=' + pageNum;
  const url = value ? baseUrl + '&search=' + encodeURIComponent(value) : baseUrl;
  window.location.href = url;
};

window.showModal = function(isEdit) {
  document.getElementById('modal-overlay').classList.remove('hidden');
  document.getElementById('modal-overlay').classList.add('flex');
  document.getElementById('modal-title').textContent = isEdit ? 'Editar Usuario' : 'Nuevo Usuario';
  document.getElementById('submit-btn').textContent = isEdit ? 'Actualizar' : 'Guardar';
  document.getElementById('password-hint').classList.toggle('hidden', !isEdit);
  document.getElementById('password').required = !isEdit;
};

window.hideModal = function() {
  document.getElementById('modal-overlay').classList.add('hidden');
  document.getElementById('modal-overlay').classList.remove('flex');
  document.getElementById('user-form').reset();
  document.getElementById('avatar-preview').innerHTML = '<span class="text-xs text-muted-foreground">Sin img</span>';
  window.currentAvatar = '';
};

window.closeModal = function(e) {
  if (e.target.id === 'modal-overlay') window.hideModal();
};

window.openEdit = function(btn) {
  const id = btn.dataset.id;
  const username = btn.dataset.user;
  const email = btn.dataset.email;
  const role = btn.dataset.role;
  const avatar = btn.dataset.avatar;

  document.getElementById('user-id').value = id;
  document.getElementById('username').value = username;
  document.getElementById('email').value = email;
  document.getElementById('role-select').value = role || 'User';
  document.getElementById('password').value = '';
  window.currentAvatar = avatar || '';

  if (avatar) {
    document.getElementById('avatar-preview').innerHTML = '<img src="' + avatar + '" class="h-16 w-16 object-cover rounded-full" />';
  }

  window.showModal(true);
};

window.compressAvatar = function(input) {
  const file = input.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = new Image();
    img.onload = function() {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      const maxSize = 150;
      let w = img.width, h = img.height;
      if (w > h) { if (w > maxSize) { h *= maxSize / w; w = maxSize; } }
      else { if (h > maxSize) { w *= maxSize / h; h = maxSize; } }
      canvas.width = w;
      canvas.height = h;
      ctx.drawImage(img, 0, 0, w, h);
      window.currentAvatar = canvas.toDataURL('image/jpeg', 0.7);
      document.getElementById('avatar-preview').innerHTML = '<img src="' + window.currentAvatar + '" class="h-16 w-16 object-cover rounded-full" />';
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
};

window.saveUser = function(e) {
  e.preventDefault();

  const id = document.getElementById('user-id').value;
  const data = new FormData();
  data.append('username', document.getElementById('username').value);
  data.append('email', document.getElementById('email').value);
  data.append('password', document.getElementById('password').value);
  data.append('role', document.getElementById('role-select').value);
  if (window.currentAvatar) data.append('avatar_url', window.currentAvatar);

  const url = id ? '/api/users/edit?id=' + id : '/api/users/create';

  fetch(url, { method: 'POST', body: data })
    .then(function(res) {
      if (res.ok) window.location.reload();
      else alert('Error al guardar');
    })
    .catch(function() { alert('Error al guardar'); });
};

window.deleteUser = function(btn) {
  if (!confirm('¿Eliminar usuario ' + btn.dataset.name + '?')) return;

  fetch('/api/users/delete?id=' + btn.dataset.id, { method: 'DELETE' })
    .then(function(res) {
      if (res.ok) window.location.reload();
      else alert('Error al eliminar');
    })
    .catch(function() { alert('Error al eliminar'); });
};
</script>
