---
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import Navbar from "@/presentation/components/shared/Navbar.astro";
import Sidebar from "@/presentation/components/shared/Sidebar.astro";
import MainLayout from "@/presentation/layouts/MainLayout.astro";

export const prerender = false;

const token = Astro.cookies.get("auth_token")?.value;
let allUsers = [];
let availableRoles = [];

try {
  console.log("Fetching users and roles from backend");
  const [usersRes, rolesRes] = await Promise.all([
    fetch("http://localhost:8081/users", {
      headers: { Authorization: `Bearer ${token}` },
    }),
    fetch("http://localhost:8081/roles", {
      headers: { Authorization: `Bearer ${token}` },
    }),
  ]);

  if (usersRes.ok) {
    allUsers = await usersRes.json();
  }

  if (rolesRes.ok) {
    availableRoles = await rolesRes.json();
  }
} catch (error) {
  console.error("Error fetching data on SSR:", error);
}
---

<MainLayout title="Gestión de Usuarios">
  <div
    class="flex h-screen flex-col"
    x-data="{
      openModal: false,
      isEdit: false,
      editId: '',
      form: { username: '', email: '', password: '', avatar_url: '', avatar_file: null, role: 'User' },
      editUser(id, username, email, roles, avatar_url) {
        console.log('Editing user:', { id, username, email, roles, avatar_url });
        this.isEdit = true;
        this.editId = id;
        this.form = { username: username || '', email: email || '', password: '', avatar_url: avatar_url || '', avatar_file: null, role: (roles && roles.length > 0) ? roles[0] : 'User' };

        // Mostrar preview si tiene avatar
        setTimeout(() => {
          const preview = document.getElementById('avatar-preview');
          if (preview && avatar_url) {
            preview.innerHTML = `<img src='${avatar_url}' class='h-16 w-16 object-cover rounded-full' />`;
          }
        }, 100);

        this.openModal = true;
        this.$nextTick(() => htmx.process(this.$refs.userForm));
      },
      resetForm() {
        this.isEdit = false;
        this.editId = '';
        this.form = { username: '', email: '', password: '', avatar_url: '', avatar_file: null, role: 'User' };
        const preview = document.getElementById('avatar-preview');
        if (preview) preview.innerHTML = '<span class="text-sm text-muted-foreground">Sin imagen</span>';
        this.$nextTick(() => htmx.process(this.$refs.userForm));
      },
      async uploadAvatar() {
        const fileInput = document.getElementById('avatar') as HTMLInputElement;
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
          return null;
        }

        const file = fileInput.files[0];
        const formData = new FormData();
        formData.append('avatar', file);

        try {
          const response = await fetch('/api/upload/avatar', {
            method: 'POST',
            body: formData
          });

          if (response.ok) {
            const data = await response.json();
            return data.url;
          }
        } catch (error) {
          console.error('Error uploading avatar:', error);
        }
        return null;
      },
    }"
    @user-created.window="openModal = false; resetForm(); htmx.process(document.body)"
     @user-updated.window="openModal = false; resetForm(); htmx.process(document.body)"
   >
    <Navbar />
    <div class="flex flex-1 overflow-hidden">
      <Sidebar />
      <main class="flex-1 overflow-y-auto bg-background p-6">
        <div class="mx-auto max-w-6xl">
          <div class="mb-8 flex items-center justify-between">
            <div>
              <h1 class="text-3xl font-bold tracking-tight text-foreground">Usuarios</h1>
              <p class="text-muted-foreground">Gestiona los accesos y roles del sistema</p>
            </div>
            <button
              class="inline-flex h-8 shrink-0 items-center justify-center gap-2 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring cursor-pointer"
              @click="resetForm(); openModal = true"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
              Nuevo Usuario
            </button>
          </div>

          <Card class="border-border bg-card">
            <CardHeader class="border-b border-border pb-4">
              <div class="flex items-center gap-4">
                <div class="relative flex-1 max-w-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                  </svg>
                  <Input
                    type="text"
                    name="search"
                    placeholder="Buscar por nombre, email o rol..."
                    class="pl-9 h-9"
                    hx-get="/api/users"
                    hx-trigger="keyup changed delay:500ms, search"
                    hx-target="#users-table-body"
                    hx-indicator=".htmx-indicator"
                  />
                </div>
                <div class="htmx-indicator flex items-center gap-2 text-xs text-muted-foreground opacity-0 transition-opacity">
                  <svg class="animate-spin h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                  </svg>
                  Buscando...
                </div>
              </div>
            </CardHeader>
            <CardContent class="p-0">
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead class="bg-muted/50 border-b border-border">
                    <tr>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">Avatar</th>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">Usuario</th>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">Email</th>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">Rol</th>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">Estado</th>
                      <th class="px-4 py-3 text-right text-xs font-semibold text-muted-foreground uppercase tracking-wider">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="users-table-body" class="divide-y divide-border">
                    {allUsers.map((user) => (
                      <tr id={`user-${user.id}`} class="border-b border-border hover:bg-muted/50 transition-colors">
                        <td class="px-4 py-3 text-sm">
                          {user.avatar_url ? (
                            <img src={user.avatar_url} alt="Avatar" class="h-10 w-10 rounded-full object-cover" />
                          ) : (
                            <div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center">
                              <span class="text-sm font-bold text-primary">
                                {(user.username || user.email).charAt(0).toUpperCase()}
                              </span>
                            </div>
                          )}
                        </td>
                        <td class="px-4 py-3 text-sm font-medium text-foreground">{user.username || 'Sin nombre'}</td>
                        <td class="px-4 py-3 text-sm text-muted-foreground">{user.email}</td>
                        <td class="px-4 py-3 text-sm">
                          <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${
                            user.roles && user.roles.includes('Admin') ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'
                          }`}>
                            {user.roles && user.roles.length > 0 ? user.roles.join(', ') : 'Sin rol'}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-sm">
                          <span class="inline-flex items-center gap-1.5 text-foreground">
                            <span class={`h-1.5 w-1.5 rounded-full ${(user.status || 'Activo') === 'Activo' ? 'bg-green-500' : 'bg-red-500'}`}></span>
                            {user.status || 'Activo'}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right text-sm">
                          <div class="flex justify-end gap-2">
                            <button
                              class="text-muted-foreground hover:text-primary transition-colors font-medium cursor-pointer"
                              @click={`editUser('${user.id}', '${user.username || ''}', '${user.email}', ${JSON.stringify(user.roles || [])}, '${user.avatar_url || ''}')`}
                            >
                              Editar
                            </button>
                            <button
                              class="text-destructive hover:text-destructive/80 transition-colors font-medium cursor-pointer"
                              hx-delete={`/api/users/delete?id=${user.id}`}
                              hx-target={`#user-${user.id}`}
                              hx-swap="outerHTML"
                              hx-confirm={`¿Estás seguro de eliminar a ${user.username || user.email}?`}
                            >
                              Eliminar
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>
        </div>
      </main>
    </div>

    <!-- Modal para Nuevo Usuario -->
    <div
      x-show="openModal"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
      @click.self="openModal = false"
      style="display: none;"
    >
      <div
        x-show="openModal"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95 translate-y-4"
        x-transition:enter-end="opacity-100 scale-100 translate-y-0"
        class="w-full max-w-md overflow-hidden rounded-xl border border-border bg-card shadow-2xl"
      >
        <div class="flex items-center justify-between border-b border-border p-4">
          <h2 class="text-lg font-semibold" x-text="isEdit ? 'Editar Usuario' : 'Crear Nuevo Usuario'"></h2>
          <button @click="openModal = false; resetForm()" class="text-muted-foreground hover:text-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <form
          x-ref="userForm" method="POST" @submit.prevent
          class="p-4 space-y-4"
          @submit="async (e) => {
            e.preventDefault();

            // Subir avatar si hay archivo seleccionado
            let avatarUrl = form.avatar_url;
            const fileInput = document.getElementById('avatar') as HTMLInputElement;
            if (fileInput && fileInput.files && fileInput.files.length > 0) {
              const uploadedUrl = await this.uploadAvatar();
              if (uploadedUrl) {
                avatarUrl = uploadedUrl;
              }
            }

            const formData = new FormData();
            formData.append('username', form.username);
            formData.append('email', form.email);
            if (form.password) formData.append('password', form.password);
            if (avatarUrl) formData.append('avatar_url', avatarUrl);
            formData.append('role', form.role);

            const url = isEdit ? '/api/users/edit?id=' + editId : '/api/users/create';
            const targetId = isEdit ? '#user-' + editId : '#users-table-body';

            try {
              const response = await fetch(url, {
                method: 'POST',
                body: formData
              });

              if (response.ok) {
                openModal = false;
                resetForm();
                // Recargar página para ver cambios
                window.location.reload();
              } else {
                const error = await response.json();
                alert(error.message || 'Error al guardar usuario');
              }
            } catch (err) {
              console.error('Error:', err);
              alert('Error al guardar usuario');
            }
          }"
        >
          <div class="space-y-2">
            <label for="username" class="text-sm font-medium">Nombre de Usuario</label>
            <Input id="username" name="username" x-model="form.username" placeholder="Ej: tatiana_3026" required />
          </div>

          <div class="space-y-2">
            <label for="email" class="text-sm font-medium">Correo Electrónico</label>
            <Input id="email" name="email" type="email" x-model="form.email" placeholder="ejemplo@test.com" required />
          </div>

          <div class="space-y-2">
            <label for="avatar" class="text-sm font-medium">Avatar</label>
            <div class="flex items-center gap-4">
              <div id="avatar-preview" class="h-16 w-16 rounded-full bg-muted flex items-center justify-center overflow-hidden">
                <span class="text-sm text-muted-foreground">Sin imagen</span>
              </div>
              <div class="flex-1">
                <Input
                  id="avatar"
                  name="avatar"
                  type="file"
                  accept="image/*"
                  @change="const file = $event.target.files[0]; if (file) { const reader = new FileReader(); reader.onload = (e) => { const preview = document.getElementById('avatar-preview'); if (preview) preview.innerHTML = `<img src='${e.target.result}' class='h-16 w-16 object-cover rounded-full' />`; }; reader.readAsDataURL(file); }"
                  class="text-sm"
                />
                <p class="text-xs text-muted-foreground mt-1">JPG, PNG o GIF. Se comprime automáticamente.</p>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label for="password" class="text-sm font-medium">Contraseña <span x-show="isEdit" class="text-[10px] text-muted-foreground">(Dejar en blanco para no cambiar)</span></label>
            <Input id="password" name="password" type="password" x-model="form.password" placeholder="••••••••" :required="!isEdit" />
          </div>

          <div class="space-y-2">
            <label for="role" class="text-sm font-medium">Rol del Usuario</label>
            <select
              id="role"
              name="role"
              x-model="form.role"
              class="flex h-9 w-full rounded-lg border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              required
            >
              <option value="User">Usuario</option>
              <option value="Admin">Administrador</option>
            </select>
          </div>

          <div class="flex justify-end gap-3 pt-4">
            <Button type="button" variant="outline" @click="openModal = false; resetForm()">Cancelar</Button>
            <Button type="submit" x-text="isEdit ? 'Actualizar Usuario' : 'Guardar Usuario'"></Button>
          </div>
        </form>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .htmx-indicator.htmx-request {
    opacity: 1;
  }
</style>
