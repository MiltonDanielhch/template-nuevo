---
import { Button } from "@/components/ui/button";
---

<nav class="border-b border-border bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/60 sticky top-0 z-50">
  <div class="flex h-14 items-center px-4 gap-4">
    <Button variant="ghost" size="sm" className="lg:hidden" @click="toggleSidebar()">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" x2="21" y1="6" y2="6"></line>
        <line x1="3" x2="21" y1="12" y2="12"></line>
        <line x1="3" x2="21" y1="18" y2="18"></line>
      </svg>
    </Button>

    <a href="/dashboard" class="flex items-center gap-2 font-semibold">
      <span class="text-primary-600">Lab</span>3026
    </a>

    <div class="flex-1"></div>

    <div class="flex items-center gap-2">
      <!-- Botón de búsqueda -->
      <button
        @click="$dispatch('open-search')"
        class="hidden sm:flex items-center gap-2 rounded-lg border border-border bg-muted/50 px-3 py-1.5 text-sm text-muted-foreground hover:bg-muted transition-colors cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden md:inline">Buscar...</span>
        <kbd class="hidden md:inline-flex items-center gap-1 rounded border border-border bg-background px-1.5 text-[10px] font-mono text-muted-foreground">
          <span class="text-xs">⌘</span>K
        </kbd>
      </button>

      <!-- Botón de búsqueda móvil -->
      <button
        @click="$dispatch('open-search')"
        class="sm:hidden flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground h-9 w-9 px-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>

      <a href="/settings" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground h-9 py-2 w-9 px-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </a>

      <button onclick="Alpine.store('theme').toggle()" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground h-9 py-2 w-9 px-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dark:hidden">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:inline">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
      </button>

      <a href="/logout" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground h-9 py-2 w-9 px-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" x2="9" y1="12" y2="12"></line>
        </svg>
      </a>
    </div>
  </div>
</nav>

<!-- Modal de búsqueda / Command Palette -->
<div
  x-data="{
    open: false,
    query: '',
    results: [],
    selectedIndex: 0,
    search() {
      const q = this.query.toLowerCase();
      if (q.length < 1) {
        this.results = [];
        return;
      }
      this.results = [
        { title: 'Dashboard', description: 'Ir al dashboard', href: '/dashboard', icon: 'home' },
        { title: 'Usuarios', description: 'Gestionar usuarios', href: '/users', icon: 'users' },
        { title: 'Roles', description: 'Gestionar roles', href: '/roles', icon: 'shield' },
        { title: 'Configuración', description: 'Ajustes del sistema', href: '/settings', icon: 'settings' },
        { title: 'Cerrar sesión', description: 'Salir de la aplicación', href: '/logout', icon: 'logout' },
      ].filter(item => item.title.toLowerCase().includes(q) || item.description.toLowerCase().includes(q));
      this.selectedIndex = 0;
    },
    navigate(direction) {
      if (this.results.length === 0) return;
      this.selectedIndex += direction;
      if (this.selectedIndex < 0) this.selectedIndex = this.results.length - 1;
      if (this.selectedIndex >= this.results.length) this.selectedIndex = 0;
    },
    execute() {
      if (this.results.length > 0 && this.results[this.selectedIndex]) {
        window.location.href = this.results[this.selectedIndex].href;
      }
    }
  }"
  @open-search.window="open = true; query = ''; results = []; setTimeout(() => document.getElementById('search-input')?.focus(), 50)"
  @keydown.window.cmd.k.prevent="open = true; query = ''; results = []; setTimeout(() => document.getElementById('search-input')?.focus(), 50)"
  @keydown.window.ctrl.k.prevent="open = true; query = ''; results = []; setTimeout(() => document.getElementById('search-input')?.focus(), 50)"
  x-show="open"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-[100] flex items-start justify-center pt-[15vh] bg-black/50 backdrop-blur-sm"
  @click.self="open = false"
  @keydown.escape.window="open = false"
  style="display: none;"
>
  <div
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 scale-95 translate-y-4"
    x-transition:enter-end="opacity-100 scale-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 scale-100 translate-y-0"
    x-transition:leave-end="opacity-0 scale-95 translate-y-4"
    class="w-full max-w-xl overflow-hidden rounded-xl border border-border bg-card shadow-2xl"
  >
    <!-- Input de búsqueda -->
    <div class="flex items-center gap-3 border-b border-border px-4 py-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="search-input"
        type="text"
        x-model="query"
        @input="search()"
        @keydown.down.prevent="navigate(1)"
        @keydown.up.prevent="navigate(-1)"
        @keydown.enter.prevent="execute()"
        placeholder="Buscar páginas, acciones..."
        class="flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
      />
      <kbd class="rounded border border-border bg-muted px-1.5 py-0.5 text-[10px] font-mono text-muted-foreground">ESC</kbd>
    </div>

    <!-- Resultados -->
    <div class="max-h-80 overflow-y-auto p-2">
      <template x-if="results.length === 0 && query.length > 0">
        <div class="py-8 text-center text-sm text-muted-foreground">
          No se encontraron resultados
        </div>
      </template>

      <template x-if="results.length === 0 && query.length === 0">
        <div class="py-4 px-2 space-y-1">
          <p class="text-xs font-medium text-muted-foreground px-2 mb-2">Páginas</p>
          <a href="/dashboard" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            <span>Dashboard</span>
          </a>
          <a href="/users" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span>Usuarios</span>
          </a>
          <a href="/roles" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <span>Roles</span>
          </a>
          <a href="/settings" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 Dashboard</span>
          </a>
        </div>
      </template>

      <template x-for="(result, index) in results" :key="result.href">
        <a
          :href="result.href"
          class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors"
          :class="selectedIndex === index ? 'bg-primary/10 text-primary' : 'hover:bg-muted'"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
            <template x-if="result.icon === 'home'">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </template>
            <template x-if="result.icon === 'users'">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            </template>
            <template x-if="result.icon === 'shield'">
              <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </template>
            <template x-if="result.icon === 'settings'">
              <circle cx="12" cy="12" r="3"></circle>
            </template>
            <template x-if="result.icon === 'logout'">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            </template>
          </svg>
          <div class="flex-1">
            <span class="font-medium" x-text="result.title"></span>
            <span class="text-muted-foreground text-xs ml-2" x-text="result.description"></span>
          </div>
          <span x-show="selectedIndex === index" class="text-xs text-muted-foreground">Enter</span>
        </a>
      </template>
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-between border-t border-border px-4 py-2 text-xs text-muted-foreground">
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-border bg-muted px-1.5 py-0.5">↑</kbd>
          <kbd class="rounded border border-border bg-muted px-1.5 py-0.5">↓</kbd>
          <span class="ml-1">Navegar</span>
        </span>
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-border bg-muted px-1.5 py-0.5">Enter</kbd>
          <span class="ml-1">Seleccionar</span>
        </span>
      </div>
      <span>Lab 3026</span>
    </div>
  </div>
</div>
