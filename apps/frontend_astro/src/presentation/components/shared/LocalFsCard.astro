---
import { Card } from "@/components/ui/card";
---

<Card className="p-4 mt-6 border-primary/20 bg-primary/5">
  <h3 class="text-lg font-semibold mb-2">Acceso a Sistema de Archivos Local</h3>
  <p class="text-sm text-muted-foreground mb-4">
    Esta tarjeta demuestra capacidades nativas adicionales usando <code>tauri-plugin-fs</code> y <code>tauri-plugin-dialog</code>.
  </p>
  
  <div class="flex flex-col sm:flex-row gap-3">
    <button
      id="btn-save-file"
      class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
      </svg>
      Guardar Log Local
    </button>
    <button
      id="btn-read-file"
      class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
      </svg>
      Leer Archivo
    </button>
  </div>
  
  <div id="fs-status" class="mt-3 text-sm hidden p-2 rounded bg-background border"></div>
</Card>

<script>
  import { writeTextFile, readTextFile } from '@tauri-apps/plugin-fs';
  import { save, open } from '@tauri-apps/plugin-dialog';
  import { isTauri } from '@tauri-apps/api/core';

  let statusEl: HTMLElement | null;

  function showStatus(message: string, isError = false) {
    if (statusEl) {
      statusEl.textContent = message;
      statusEl.classList.remove('hidden', 'text-red-500', 'text-green-600');
      statusEl.classList.add(isError ? 'text-red-500' : 'text-green-600');
    }
  }

  async function handleSaveFile() {
    if (!isTauri()) {
      showStatus("Esta funcionalidad solo está disponible en la app de escritorio (Tauri).", true);
      return;
    }
    
    try {
      const filePath = await save({
        title: 'Guardar Log de la App',
        filters: [{ name: 'Archivos de Texto', extensions: ['txt', 'log'] }],
        defaultPath: 'laboratorio-3026.log',
      });

      if (filePath) {
        const content = `Laboratorio 3026 Log\nGenerado: ${new Date().toISOString()}`;
        await writeTextFile(filePath, content);
        showStatus(`¡Archivo guardado exitosamente en: ${filePath}!`);
      }
    } catch (error) {
      console.error(error);
      showStatus(`Error al guardar: ${String(error)}`, true);
    }
  }

  async function handleReadFile() {
    if (!isTauri()) {
      showStatus("Esta funcionalidad solo está disponible en la app de escritorio (Tauri).", true);
      return;
    }

    try {
      const file = await open({
        title: 'Abrir Archivo',
        multiple: false,
        directory: false,
      });

      if (file) {
        // file could be string or null if not multiple
        const content = await readTextFile(file);
        showStatus(`Contenido leído (${content.length} caracteres): ${content.substring(0, 50)}...`);
      }
    } catch (error) {
      console.error(error);
      showStatus(`Error al leer archivo: ${String(error)}`, true);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    statusEl = document.getElementById('fs-status');
    document.getElementById('btn-save-file')?.addEventListener('click', handleSaveFile);
    document.getElementById('btn-read-file')?.addEventListener('click', handleReadFile);
  });
</script>
