---
---
<div
  x-data
  @keydown.window.prevent.cmd.k="$store.commandPalette.toggle()"
  @keydown.window.prevent.ctrl.k="$store.commandPalette.toggle()"
  class="relative z-[100]"
>
  <!-- Overlay -->
  <div
    x-show="$store.commandPalette.open"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-background/80 backdrop-blur-sm"
    @click="$store.commandPalette.toggle()"
  ></div>

  <!-- Palette -->
  <div
    x-show="$store.commandPalette.open"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 scale-100"
    x-transition:leave-end="opacity-0 scale-95"
    class="fixed left-1/2 top-[20%] w-full max-w-xl -translate-x-1/2 overflow-hidden rounded-xl border border-border bg-surface shadow-2xl"
  >
    <div class="flex items-center border-b border-border px-4 py-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mr-3">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="command-input"
        type="text"
        x-model="$store.commandPalette.query"
        placeholder="Escribe un comando o busca..."
        class="flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
      />
      <div class="flex items-center gap-1 rounded border border-border bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
        <span>ESC</span>
      </div>
    </div>

    <div class="max-h-72 overflow-y-auto p-2">
      <template x-for="item in $store.commandPalette.filteredItems" :key="item.label">
        <a
          :href="item.href"
          class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-foreground transition-colors hover:bg-primary/10 hover:text-primary group"
          @click="$store.commandPalette.toggle()"
        >
          <div class="flex h-8 w-8 items-center justify-center rounded border border-border bg-muted group-hover:border-primary/20 group-hover:bg-primary/10">
            <template x-if="item.icon === 'dashboard'">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            </template>
            <template x-if="item.icon === 'users'">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </template>
            <template x-if="item.icon === 'settings'">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            </template>
            <template x-if="item.icon === 'logout'">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            </template>
          </div>
          <span class="flex-1" x-text="item.label"></span>
          <span class="text-[10px] text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity">Ir</span>
        </a>
      </template>

      <div x-show="$store.commandPalette.filteredItems.length === 0" class="px-4 py-8 text-center text-sm text-muted-foreground">
        No se encontraron resultados para "<span x-text="$store.commandPalette.query"></span>"
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-border bg-muted/50 px-4 py-2 text-[10px] text-muted-foreground">
      <div class="flex gap-4">
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-border bg-surface px-1 py-0.5 font-sans">↑↓</kbd> Navegar
        </span>
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-border bg-surface px-1 py-0.5 font-sans">Enter</kbd> Seleccionar
        </span>
      </div>
      <div class="flex gap-4">
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-border bg-surface px-1 py-0.5 font-sans">Ctrl</kbd> + <kbd class="rounded border border-border bg-surface px-1 py-0.5 font-sans">K</kbd> Abrir
        </span>
      </div>
    </div>
  </div>
</div>
