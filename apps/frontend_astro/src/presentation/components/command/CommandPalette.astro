---
---
<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.store('commandPalette', {
      open: false,
      search: '',
      selectedIndex: 0,
      items: [
        { label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6', shortcut: 'G D', action: () => window.location.href = '/dashboard' },
        { label: 'Usuarios', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z', shortcut: 'G U', action: () => window.location.href = '/users' },
        { label: 'Configuración', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z', shortcut: 'G S', action: () => window.location.href = '/settings' }
      ],
      get filteredItems() {
        if (!this.search) return this.items;
        return this.items.filter(i => i.label.toLowerCase().includes(this.search.toLowerCase()));
      },
      toggle() {
        this.open = !this.open;
        if (this.open) {
          this.search = '';
          this.selectedIndex = 0;
          this.$nextTick(() => {
             const input = document.querySelector('input[x-ref=\"searchInput\"]');
             if(input) input.focus();
          });
        }
      },
      close() {
        this.open = false;
      },
      execute(item) {
        item.action();
        this.close();
      }
    });
  });
</script>
<div
  x-data
  @keydown.window.prevent.cmd.k="$store.commandPalette.toggle()"
  @keydown.window.prevent.ctrl.k="$store.commandPalette.toggle()"
  class="relative z-[100]"
  role="dialog"
  aria-modal="true"
  x-show="$store.commandPalette.open"
  x-cloak
>
  <!-- Overlay -->
  <div
    x-show="$store.commandPalette.open"
    x-transition:enter="ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-background/80 backdrop-blur-sm transition-opacity"
    @click="$store.commandPalette.close()"
  ></div>

  <!-- Command Palette Panel -->
  <div class="fixed inset-0 z-10 overflow-y-auto p-4 sm:p-6 md:p-20">
    <div
      x-show="$store.commandPalette.open"
      x-transition:enter="ease-out duration-300"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="ease-in duration-200"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
      class="mx-auto max-w-2xl transform divide-y divide-border overflow-hidden rounded-xl bg-surface border border-border shadow-2xl ring-1 ring-black ring-opacity-5 transition-all"
      @click.away="$store.commandPalette.close()"
    >
      <div class="relative">
        <svg class="pointer-events-none absolute left-4 top-3.5 h-5 w-5 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
        </svg>
        <input
          type="text"
          class="h-12 w-full border-0 bg-transparent pl-11 pr-4 text-foreground placeholder-muted-foreground focus:ring-0 sm:text-sm"
          placeholder="Buscar comandos o páginas... (Esc para cerrar)"
          x-model="$store.commandPalette.search"
          @keydown.escape="$store.commandPalette.close()"
          x-ref="searchInput"
        >
      </div>

      <!-- Results -->
      <ul class="max-h-96 scroll-py-2 overflow-y-auto py-2 text-sm text-foreground" x-show="$store.commandPalette.filteredItems.length > 0">
        <template x-for="item in $store.commandPalette.filteredItems" :key="item.label">
          <li>
            <button
              @click="$store.commandPalette.execute(item)"
              class="flex w-full cursor-default select-none items-center px-4 py-2 hover:bg-muted"
              :class="{ 'bg-muted': $store.commandPalette.selectedIndex === $store.commandPalette.filteredItems.indexOf(item) }"
            >
              <svg class="h-5 w-5 flex-none text-muted-foreground" :class="{ 'text-primary': $store.commandPalette.selectedIndex === $store.commandPalette.filteredItems.indexOf(item) }" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="item.icon" />
              </svg>
              <span class="ml-3 flex-auto truncate" x-text="item.label"></span>
              <span class="ml-3 flex-none text-xs font-semibold text-muted-foreground" x-text="item.shortcut"></span>
            </button>
          </li>
        </template>
      </ul>

      <!-- Empty State -->
      <div class="px-6 py-14 text-center sm:px-14" x-show="$store.commandPalette.filteredItems.length === 0">
        <svg class="mx-auto h-6 w-6 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="mt-4 text-sm text-foreground">No se encontraron resultados para "<span x-text="$store.commandPalette.search"></span>"</p>
      </div>

      <!-- Footer -->
      <div class="flex flex-wrap items-center bg-muted/50 px-4 py-2.5 text-xs text-muted-foreground">
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-border bg-surface px-1 py-0.5 font-sans">Enter</kbd> para seleccionar
        </span>
        <span class="mx-3 h-3 w-px bg-border"></span>
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-border bg-surface px-1 py-0.5 font-sans">Esc</kbd> para cerrar
        </span>
        <span class="mx-3 h-3 w-px bg-border"></span>
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-border bg-surface px-1 py-0.5 font-sans">⌘</kbd>
          <kbd class="rounded border border-border bg-surface px-1 py-0.5 font-sans">K</kbd> Abrir
        </span>
      </div>
    </div>
  </div>
</div>
