---
import "../../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import CommandPalette from "../components/command/CommandPalette.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const token = Astro.cookies.get("auth_token")?.value || "";
---

<!DOCTYPE html>
<html lang="es" transition:persist>
  <head>
    <ViewTransitions />
    <!-- Capacitor Plugins -->
    <script src="https://unpkg.com/@capacitor/core@6/dist/capacitor.js"></script>
    <script is:inline>
      // Capacitor Auth Storage
      window.CapacitorStorage = {
        async getToken() {
          if (window.Capacitor && window.Capacitor.isNativePlatform()) {
            const { Preferences } = window.Capacitor.Plugins;
            const result = await Preferences.get({ key: 'auth_token' });
            return result.value;
          }
          return localStorage.getItem('auth_token');
        },
        async setToken(token) {
          if (window.Capacitor && window.Capacitor.isNativePlatform()) {
            const { Preferences } = window.Capacitor.Plugins;
            await Preferences.set({ key: 'auth_token', value: token });
          } else {
            localStorage.setItem('auth_token', token);
          }
        },
        async removeToken() {
          if (window.Capacitor && window.Capacitor.isNativePlatform()) {
            const { Preferences } = window.Capacitor.Plugins;
            await Preferences.remove({ key: 'auth_token' });
          } else {
            localStorage.removeItem('auth_token');
          }
        }
      };
    </script>
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();

      // Mantener tema en View Transitions
      document.addEventListener('astro:after-swap', () => {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="Laboratorio 3026 - Sistema de Gestión" />
    <meta name="theme-color" content="#0ea5e9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title} | Laboratorio 3026</title>
    <meta name="auth-token" content={token} />

    <!-- HTMX -->
    <script is:inline src="https://unpkg.com/htmx.org@2.0.8/dist/htmx.min.js" crossorigin="anonymous"></script>

    <!-- Alpine.js Plugins -->

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (typeof htmx !== 'undefined') {
          htmx.config.defaultSwapStyle = 'innerHTML';
          htmx.config.defaultSettleDelay = 0;
          htmx.config.historyCacheSize = 0;
          htmx.config.refreshOnHistoryMiss = false;

          // Logs de errores solo cuando falla
          document.body.addEventListener('htmx:responseError', (e) => {
            console.error("HTMX Response Error:", e.detail.xhr.status, e.detail.xhr.responseText);
          });

          document.body.addEventListener('htmx:sendError', (e) => {
            console.error("HTMX Send Error (Red):", e.detail);
          });
        }
      });

      document.addEventListener('htmx:configRequest', (e) => {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (csrfToken) {
          e.detail.headers['X-CSRF-Token'] = csrfToken;
        }
      });

      document.addEventListener('htmx:beforeRequest', (e) => {
        const target = e.detail?.target;
        if (!target) return;
        const indicator = target.querySelector?.('.htmx-indicator') ||
                          document.querySelector(`#${target.id} .htmx-indicator`);
        if (indicator) {
          indicator.classList.remove('hidden');
        }
      });

      document.addEventListener('alpine:initialized', () => {
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 1024 && Alpine.store('app')) {
            Alpine.store('app').sidebarOpen = true;
          }
        });
      });

      document.addEventListener('htmx:afterRequest', (e) => {
        const target = e.detail?.target;
        if (!target) return;
        const indicator = target.querySelector?.('.htmx-indicator') ||
                          document.querySelector(`#${target.id} .htmx-indicator`);
        if (indicator) {
          indicator.classList.add('hidden');
        }
      });

      document.addEventListener('htmx:afterSwap', (e) => {
        try {
          const response = e.detail?.xhr?.response;
          if (response) {
            const data = JSON.parse(response);
            if (data.message) {
              const toast = document.createElement('div');
              toast.className = `fixed bottom-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 ${data.success ? 'bg-green-600' : 'bg-red-600'} text-white`;
              toast.textContent = data.message;
              document.body.appendChild(toast);
              setTimeout(() => toast.remove(), 3000);
            }
          }
        } catch (err) {}
      });
    </script>

    <script>
      import { load } from '@tauri-apps/plugin-store';
      import { isTauri } from '@tauri-apps/api/core';

      document.addEventListener('DOMContentLoaded', async () => {
        if (isTauri()) {
          try {
            const tokenInfo = document.querySelector('meta[name="auth-token"]')?.getAttribute('content');
            const store = await load('store.json', { autoSave: false, defaults: {} });

            if (tokenInfo) {
              await store.set('auth_token', tokenInfo);
            } else {
              await store.delete('auth_token');
            }
            await store.save();
          } catch (err) {
            console.error("Error sync token to Native Store:", err);
          }
        }
      });
    </script>
  </head>
  <body class="min-h-screen bg-background text-text">
    <script is:inline>
      window.sidebarOpen = window.innerWidth >= 1024;
      function toggleSidebar() {
        window.sidebarOpen = !window.sidebarOpen;
        updateSidebar();
      }
      function updateSidebar() {
        const sidebar = document.getElementById('main-sidebar');
        const btn = document.getElementById('sidebar-toggle-btn');
        const closeBtn = document.getElementById('sidebar-close-btn');
        if (sidebar) {
          if (window.sidebarOpen) {
            sidebar.classList.remove('-translate-x-full');
            sidebar.classList.add('translate-x-0');
          } else {
            sidebar.classList.remove('translate-x-0');
            sidebar.classList.add('-translate-x-full');
          }
        }
        if (btn) btn.style.display = window.innerWidth < 1024 ? 'flex' : 'none';
        if (closeBtn) closeBtn.style.display = window.innerWidth < 1024 && window.sidebarOpen ? 'flex' : 'none';
      }
      document.addEventListener('DOMContentLoaded', updateSidebar);
      window.addEventListener('resize', updateSidebar);

      window.__registerRolesAlpine = function() {
        if (typeof Alpine === 'undefined' || !Alpine) return;

        Alpine.data('rolesManagement', () => ({
          openModal: false,
          isEdit: false,
          editId: '',
          form: { name: '', description: '', permissions: [] },
          availablePermissions: window.__rolesPermissions || [],

          init() {
            console.log('Roles Management initialized');
          },

          editRole(roleData) {
            const role = typeof roleData === 'string' ? JSON.parse(roleData) : roleData;
            this.isEdit = true;
            this.editId = role.id;
            this.form = {
              name: role.name,
              description: role.description || '',
              permissions: role.permissions.map(p => p.id)
            };
            this.openModal = true;
          },

          resetForm() {
            this.isEdit = false;
            this.editId = '';
            this.form = { name: '', description: '', permissions: [] };
          },

          async submitForm() {
            const url = this.isEdit ? `/api/roles/${this.editId}` : '/api/roles';
            try {
              const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(this.form)
              });
              if (response.ok) {
                window.location.reload();
              } else {
                const data = await response.json();
                alert(data.message || 'Error al procesar');
              }
            } catch (e) {
              alert('Error de conexión');
            }
          }
        }));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => window.__registerRolesAlpine());
      } else {
        window.__registerRolesAlpine();
      }

      document.addEventListener('astro:page-load', () => window.__registerRolesAlpine());
    </script>
    <CommandPalette />
    <div id="app">
      <slot />
    </div>
  </body>
</html>
