---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" x-data="{
  darkMode: localStorage.getItem('theme') === 'dark',
  toggleDarkMode() {
    this.darkMode = !this.darkMode;
    localStorage.setItem('theme', this.darkMode ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', this.darkMode);
  },
  init() {
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      this.darkMode = true;
      document.documentElement.classList.add('dark');
    }
  }
}" x-init="init()">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Laboratorio 3026 - Sistema de Gestión" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Laboratorio 3026</title>

    <!-- HTMX -->
    <script is:inline src="https://unpkg.com/htmx.org@2.0.8"></script>

    <!-- HTMX Extensions -->
    <script is:inline src="https://unpkg.com/htmx.org@2.0.8/dist/ext/json-enc.js"></script>
    <script is:inline src="https://unpkg.com/htmx.org@2.0.8/dist/ext/csrf.js"></script>

    <!-- Alpine.js Plugins -->
    <script defer is:inline src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"></script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (typeof htmx !== 'undefined') {
          htmx.config.defaultSwapStyle = 'innerHTML';
          htmx.config.defaultSettleDelay = 0;
          htmx.config.historyCacheSize = 0;
          htmx.config.refreshOnHistoryMiss = false;

          htmx.ajaxPrefilter((options) => {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
            if (csrfToken) {
              options.headers = options.headers || {};
              options.headers['X-CSRF-Token'] = csrfToken;
            }
          });
        }
      });

      document.addEventListener('htmx:beforeRequest', (e) => {
        const target = e.detail?.target;
        if (!target) return;
        const indicator = target.querySelector?.('.htmx-indicator') ||
                          document.querySelector(`#${target.id} .htmx-indicator`);
        if (indicator) {
          indicator.classList.remove('hidden');
        }
      });

      document.addEventListener('htmx:afterRequest', (e) => {
        const target = e.detail?.target;
        if (!target) return;
        const indicator = target.querySelector?.('.htmx-indicator') ||
                          document.querySelector(`#${target.id} .htmx-indicator`);
        if (indicator) {
          indicator.classList.add('hidden');
        }
      });

      document.addEventListener('htmx:afterSwap', (e) => {
        try {
          const response = e.detail?.xhr?.response;
          if (response) {
            const data = JSON.parse(response);
            if (data.message) {
              const toast = document.createElement('div');
              toast.className = `fixed bottom-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 ${data.success ? 'bg-green-600' : 'bg-red-600'} text-white`;
              toast.textContent = data.message;
              document.body.appendChild(toast);
              setTimeout(() => toast.remove(), 3000);
            }
          }
        } catch (err) {}
      });
    </script>
  </head>
  <body class="min-h-screen bg-background text-text transition-colors duration-200">
    <div id="app">
      <slot />
    </div>
  </body>
</html>
