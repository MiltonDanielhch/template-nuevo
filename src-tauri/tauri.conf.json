{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lab3026",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../apps/frontend_astro/dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "bun --cwd apps/frontend_astro run dev",
    "beforeBuildCommand": "bun --cwd apps/frontend_astro run build"
  },
  "app": {
    "windows": [
      {
        "title": "Laboratorio 3026 - Soberanía de Escritorio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
