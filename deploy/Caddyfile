# =============================================================================
# NOTA PARA DEPLOY EN VPS LIMPIO:
#   En un VPS (no rootless), Podman resolve correctamente los nombres de
#   contenedores. Cambiar las IPs por: app:8080 o lab3026_api:8080
#
#   Ejemplo para VPS:
#     reverse_proxy app:8080
#     reverse_proxy lab3026_api:8080
#
#   Este archivo usa IP hardcodeada (10.89.0.19) porque en WSL2 rootless
#   el DNS de Podman no funciona correctamente.
# =============================================================================

# Bloque HTTP (Puerto 80 interno -> 9080 externo)
:80 {
    log
    reverse_proxy 10.89.0.19:8080
}

# Bloque HTTPS (Puerto 443 interno -> 9443 externo)
:443 {
    tls internal
    reverse_proxy 10.89.0.19:8080
}
