# Caddyfile - Configuración del Proxy Inverso
# Sintonía de Seguridad: HTTPS Automático y Headers Seguros

# Dominio (Reemplazar con tu dominio real en producción, ej: api.midominio.com)
# Para local usamos localhost
localhost {
    # Proxy inverso hacia el contenedor de la API (nombre del servicio en compose:puerto)
    reverse_proxy app:8080

    # Compresión Gzip/Zstd para velocidad
    encode zstd gzip

    # Headers de Seguridad (Best Practices)
    header {
        # Habilitar HSTS (Strict Transport Security)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevenir que la web sea embebida en iframes (Clickjacking)
        X-Frame-Options "DENY"
        # Prevenir sniffing de contenido
        X-Content-Type-Options "nosniff"
        # Protección XSS básica
        X-XSS-Protection "1; mode=block"
    }

    # Logs estructurados
    log {
        output stdout
        format json
    }
}
