# --- Código 3026: Plantilla de Entorno ---
# Copia este archivo a .env y ajusta los valores para tu entorno local.

# --- Servidor (API Server) ---
RUST_LOG=info,core_logic=debug,api_server=debug
# Configuración del servidor (Por defecto 0.0.0.0:8080)
HOST=0.0.0.0
SERVER_PORT=8080

# --- Base de Datos (Infra DB) ---
# Se activará en el Bloque I
DATABASE_URL=sqlite://backend.db?mode=rwc

# --- Seguridad (Auth) ---
JWT_SECRET=cambiar_esto_por_una_cadena_larga_y_segura_en_produccion
